<group name="unifi,syslog,">

    <!-- Base rule: every UniFi CEF event. Level 2 keeps routine events out of alerts. -->
    <rule id="100010" level="2">
        <decoded_as>ubiquiti</decoded_as>
        <description>UniFi: $(event.name)</description>
    </rule>

    <!-- Security -->
    <rule id="100100" level="13">
        <if_sid>100010</if_sid>
        <field name="unifi_category">^Security$</field>
        <field name="unifi_sub-category">^Intrusion</field>
        <field name="unifi_risk">^high$</field>
        <description>UniFi: Intrusion attempt, high risk - $(event.name)</description>
        <group>ids,attack,</group>
    </rule>

    <rule id="100101" level="10">
        <if_sid>100010</if_sid>
        <field name="unifi_category">^Security$</field>
        <field name="unifi_sub-category">^Intrusion</field>
        <description>UniFi: Intrusion attempt - $(event.name)</description>
        <group>ids,</group>
    </rule>

    <rule id="100102" level="10">
        <if_sid>100010</if_sid>
        <field name="event.name" type="pcre2">(?i)honeypot</field>
        <description>UniFi: Honeypot triggered - $(event.name)</description>
        <group>ids,attack,</group>
    </rule>

    <rule id="100104" level="7">
        <if_sid>100010</if_sid>
        <field name="unifi_category">^Security$</field>
        <description>UniFi: Security event - $(event.name)</description>
    </rule>

    <!-- Child of 100104 so it can lower the level: sibling rules are tried highest level first -->
    <rule id="100103" level="5">
        <if_sid>100104</if_sid>
        <field name="unifi_sub-category">^Firewall</field>
        <description>UniFi: Firewall - $(event.name)</description>
        <group>firewall,</group>
    </rule>

    <!-- Admin activity and configuration -->
    <rule id="100200" level="3">
        <if_sid>100010</if_sid>
        <field name="event.name" type="pcre2">^Admin Accessed</field>
        <description>UniFi: $(unifi_admin) accessed UniFi via $(unifi_access_method) from $(src)</description>
        <group>authentication_success,</group>
    </rule>

    <rule id="100201" level="5">
        <if_sid>100010</if_sid>
        <field name="event.name">^Config Modified$</field>
        <description>UniFi: $(unifi_admin) modified $(unifi_settings_section) settings ($(unifi_settings_entry))</description>
        <group>config_changed,</group>
    </rule>

    <!-- Internet and devices -->
    <rule id="100300" level="8">
        <if_sid>100010</if_sid>
        <field name="event.name" type="pcre2">(?i)failover|internet (?:outage|down)|wan .*(?:down|offline)</field>
        <description>UniFi: WAN/Internet issue - $(event.name)</description>
    </rule>

    <rule id="100301" level="7">
        <if_sid>100010</if_sid>
        <field name="event.name" type="pcre2">(?i)\boffline\b|disconnected from controller</field>
        <description>UniFi: Device offline - $(event.name)</description>
    </rule>

    <!-- Severity-based fallbacks for anything not matched above -->
    <rule id="100390" level="12">
        <if_sid>100010</if_sid>
        <field name="event.severity" type="pcre2">^(?:9|10)$</field>
        <description>UniFi: High severity event - $(event.name)</description>
    </rule>

    <rule id="100391" level="10">
        <if_sid>100010</if_sid>
        <field name="event.severity" type="pcre2">^[78]$</field>
        <description>UniFi: Elevated severity event - $(event.name)</description>
    </rule>

    <rule id="100392" level="5">
        <if_sid>100010</if_sid>
        <field name="event.severity" type="pcre2">^[4-6]$</field>
        <description>UniFi: $(event.name)</description>
    </rule>

</group>
